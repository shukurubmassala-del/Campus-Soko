# CampusSoko - Environment Configuration

# Firebase Client Configuration (Vite client env vars must start with VITE_)
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="campussoko-udsm.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="campussoko-udsm"
VITE_FIREBASE_STORAGE_BUCKET="campussoko-udsm.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# App URL (Injected by hosting environment)
APP_URL="MY_APP_URL"
